{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvalRunSchema",
  "type": "object",
  "required": [
    "run_id",
    "provider",
    "model",
    "prompt_sha256",
    "fixture_sha256",
    "started_at",
    "completed_at",
    "raw_output_sha256",
    "structured_findings"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "model_revision": { "type": "string" },
    "temperature": { "type": "number" },
    "seed": { "type": "integer" },
    "prompt_sha256": { "type": "string" },
    "fixture_sha256": { "type": "string" },
    "started_at": { "type": "string" },
    "completed_at": { "type": "string" },
    "input_tokens": { "type": "integer" },
    "output_tokens": { "type": "integer" },
    "raw_output_sha256": { "type": "string" },
    "structured_findings": {
      "type": "array"
    }
  }
}
