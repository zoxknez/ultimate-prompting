{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FindingSchema",
  "type": "object",
  "required": [
    "finding_id",
    "title",
    "severity",
    "evidence_level",
    "paths",
    "cause",
    "impact",
    "repair"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "evidence_level": {
      "type": "string",
      "enum": ["E0", "E1", "E2", "E3", "E4", "E5"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": { "type": "string" },
          "start_line": { "type": "integer" },
          "end_line": { "type": "integer" }
        }
      }
    },
    "cause": { "type": "string" },
    "impact": { "type": "string" },
    "repair": { "type": "string" },
    "verification": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
