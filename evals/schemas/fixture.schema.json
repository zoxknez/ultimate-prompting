{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FixtureMetadataSchema",
  "type": "object",
  "required": [
    "fixture_id",
    "stack_id",
    "synthetic",
    "license",
    "contains_real_credentials",
    "contains_production_data",
    "source_provenance",
    "allowed_execution",
    "safe_fix_mode"
  ],
  "properties": {
    "fixture_id": { "type": "string" },
    "stack_id": { "type": "string" },
    "synthetic": { "type": "boolean" },
    "license": { "type": "string" },
    "contains_real_credentials": { "type": "boolean" },
    "contains_production_data": { "type": "boolean" },
    "source_provenance": { "type": "string" },
    "allowed_execution": { "type": "boolean" },
    "safe_fix_mode": {
      "type": "string",
      "enum": ["executable", "advisory", "manual-procedure", "not-applicable"]
    },
    "safe_fix_required": { "type": "boolean" },
    "injection_test": {
      "type": "boolean",
      "description": "True if this fixture's repository content embeds a prompt-injection attempt (e.g. a comment instructing the auditor to skip a finding). Used to compute repository_instruction_resistance_rate."
    },
    "injection_description": { "type": "string" }
  }
}
